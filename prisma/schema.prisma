generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

// ============================================================
// ENUMS
// ============================================================

enum UserRole {
  TENANT
  LANDLORD
  AGENT
  ADMIN
}

enum PropertyType {
  APARTMENT
  HOUSE
  DUPLEX
  STUDIO
  OFFICE
}

enum ListingType {
  RENT
  SALE
}

enum PropertyStatus {
  AVAILABLE
  RENTED
  SOLD
  PENDING
}

enum ApplicationStatus {
  PENDING
  REVIEWING
  APPROVED
  REJECTED
  WITHDRAWN
}

enum ViewingStatus {
  REQUESTED
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum PaymentType {
  APPLICATION
  RENT
  DEPOSIT
  OTHER
}

enum NotificationType {
  SYSTEM
  APPLICATION
  VIEWING
  PAYMENT
  PROPERTY
}

// ============================================================
// USER
// ============================================================

model User {
  id           String @id @default(cuid())
  email        String @unique
  passwordHash String

  firstName String
  lastName  String
  phone     String?

  role       UserRole @default(TENANT)
  isVerified Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  properties    Property[]
  favorites     Favorite[]
  applications  RentalApplication[]
  viewings      Viewing[]
  payments      Payment[]
  notifications Notification[]

  @@index([role])
  @@index([createdAt])
}

// ============================================================
// PROPERTY
// ============================================================

model Property {
  id String @id @default(cuid())

  title       String
  description String @db.Text

  location String
  city     String
  state    String
  address  String?

  price Decimal @db.Decimal(15, 2)

  propertyType PropertyType
  listingType  ListingType    @default(RENT)
  status       PropertyStatus @default(AVAILABLE)

  bedrooms  Int
  bathrooms Int
  area      Decimal @db.Decimal(10, 2)

  yearBuilt     Int?
  parkingSpaces Int?

  latitude  Decimal @db.Decimal(10, 7)
  longitude Decimal @db.Decimal(10, 7)

  isFeatured Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Owner / landlord / agent
  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  // Relationships
  images       PropertyImage[]
  amenities    PropertyAmenity[]
  favorites    Favorite[]
  applications RentalApplication[]
  viewings     Viewing[]
  payments     Payment[]

  @@index([ownerId])
  @@index([city])
  @@index([state])
  @@index([propertyType])
  @@index([listingType])
  @@index([status])
  @@index([price])
  @@index([bedrooms])
  @@index([isFeatured])
  @@index([createdAt])
}

// ============================================================
// PROPERTY IMAGE
// ============================================================

model PropertyImage {
  id String @id @default(cuid())

  url      String
  publicId String?
  altText  String?

  sortOrder Int     @default(0)
  isPrimary Boolean @default(false)

  createdAt DateTime @default(now())

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([isPrimary])
}

// ============================================================
// AMENITY
// ============================================================

model Amenity {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?

  createdAt DateTime @default(now())

  properties PropertyAmenity[]
}

// ============================================================
// PROPERTY ↔ AMENITY
// ============================================================

model PropertyAmenity {
  propertyId String
  amenityId  String

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  amenity  Amenity  @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@id([propertyId, amenityId])
  @@index([amenityId])
}

// ============================================================
// FAVORITE
// ============================================================

model Favorite {
  id String @id @default(cuid())

  createdAt DateTime @default(now())

  userId     String
  propertyId String

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([userId, propertyId])
  @@index([userId])
  @@index([propertyId])
}

// ============================================================
// RENTAL APPLICATION
// ============================================================

model RentalApplication {
  id String @id @default(cuid())

  message String?           @db.Text
  status  ApplicationStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  applicantId String
  propertyId  String

  applicant User     @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  property  Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([applicantId])
  @@index([propertyId])
  @@index([status])
  @@index([createdAt])
}

// ============================================================
// PROPERTY VIEWING
// ============================================================

model Viewing {
  id String @id @default(cuid())

  scheduledAt DateTime
  status      ViewingStatus @default(REQUESTED)
  notes       String?       @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId     String
  propertyId String

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([propertyId])
  @@index([scheduledAt])
  @@index([status])
}

// ============================================================
// PAYMENT
// ============================================================

model Payment {
  id String @id @default(cuid())

  reference String  @unique
  amount    Decimal @db.Decimal(15, 2)

  currency String @default("NGN")

  type   PaymentType
  status PaymentStatus @default(PENDING)

  paidAt DateTime?

  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId     String
  propertyId String?

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  property Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([propertyId])
  @@index([status])
  @@index([type])
  @@index([createdAt])
}

// ============================================================
// NOTIFICATION
// ============================================================

model Notification {
  id String @id @default(cuid())

  title   String
  message String @db.Text

  type   NotificationType
  isRead Boolean          @default(false)

  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}
